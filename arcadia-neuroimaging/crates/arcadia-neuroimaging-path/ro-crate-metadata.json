   "nrr:applicabilityConditions": {
    "organism": "NCBITaxon:10090",
    "species": "Mus musculus",
    "strain": "DBA/2J",
    "strainIdentifier": "RRID:IMSR_JAX:000671",
    "genotype": "wild type",
    "sex": "female",
    "animalsInStudy": 5,
    "animalsPerTrial": 1,
    "anesthesia": "3-4% isoflurane for induction; maintained at 1.25-1.5% during imaging (from trial file names); depth confirmed by loss of righting reflex, ~1 breath per second, no toe-pinch response",
    "preparation": "head-fixed with earbars in a stereotaxic frame (Kopf); heating pad; hair removed with Nair; eye ointment; 1 mL body-temperature sterile saline subcutaneous; 0.1 mL 1% lidocaine subcutaneous under the scalp; scalp removed; periosteum cleaned; thin layer of cyanoacrylate glue applied to the skull for optical clarity",
    "invasiveness": "through-skull, label-free; no craniotomy, no transgenic animals, no dye or virus injection",
    "instrument": "ultra-widefield microscope (UWFM), custom built",
    "readout": "flavoprotein autofluorescence, dF/F over a region of interest",
    "imaging": "10 frames per second, 13.4 x 11.3 mm, 5 um/px with no binning; cropped to the brain and binned 4 x 4 for all trials",
    "analysis": "temporal averaging: 2 frames for tactile trials, 8 frames for injection trials, to reduce noise; motion correction by SIFT-based registration; brain masking by flood fill (scikit-image flood); bleach correction: subtract the bottom 5% of pixels within the brain from each frame; baseline autofluorescence subtraction",
    "statistics": "none reported; no significance testing, no power analysis, no detection limit stated anywhere in the pub"
   },
   "nrr:invalidators": [
    "a repeat of the itch experiment with a sensitive genetically encoded calcium indicator that resolves a histamine-specific signal",
    "the same experiment in non-anaesthetized animals, since anaesthesia suppresses cortical activity",
    "an injection-artifact control that separates needle and handling responses from the pruritogen response"
   ],
   "nrr:untriedBranches": [
    {
     "description": "Repeat the itch experiments with a sensitive genetically encoded calcium indicator such as GCaMP to increase signal, testing the hypothesis that too few itch-responsive neurons produce too little autofluorescence to detect above noise.",
     "status": "proposed-by-authors",
     "source": "Next steps"
    },
    {
     "description": "Perform the experiments on non-anesthetized animals, because anesthesia is known to suppress cortical activity (ref 33).",
     "status": "proposed-by-authors",
     "source": "Next steps"
    },
    {
     "description": "Repeat the capsaicin experiments to distinguish activity patterns inherent to the brain from those caused by experimental variability, and determine what injection location, dose and prior-injection factors contribute to the oscillations.",
     "status": "proposed-by-authors",
     "source": "Next steps"
    },
    {
     "description": "Test analgesic drugs to see whether they alleviate pain-related sensory activity in the brain, as a check on drug-screening applicability.",
     "status": "proposed-by-authors",
     "source": "Next steps"
    },
    {
     "description": "Perform this imaging on chronic mouse pain and itch models rather than the acute models used here.",
     "status": "proposed-by-authors",
     "source": "Next steps"
    },
    {
