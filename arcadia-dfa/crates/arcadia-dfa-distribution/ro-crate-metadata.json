    "metric": "fraction of species carrying a divergent actin, per fungal order",
    "value": "variable across and within orders, neither zero nor one for many orders",
    "n": 853,
    "direction": "not-applicable",
    "comparedTo": "canonical actin, which is highly conserved across the kingdom",
    "note": "the fraction of species possessing a DFA varies widely across fungal orders and is neither zero nor one for many orders, so DFA appears evolutionarily labile in contrast to canonical actin, which is highly conserved"
   },
   "nrr:controls": {
    "positive": {
     "kind": "known-positive-task",
